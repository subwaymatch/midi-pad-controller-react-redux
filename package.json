{
  "name": "midi-pad-controller",
  "version": "1.0.0",
  "private": true,
  "description": "A browser drum pad with 99 samples, keyboard shortcuts and customizable pads. Built with Next.js and Redux Toolkit; deploys as a static site to Cloudflare or GitHub Pages.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "next build && wrangler dev",
    "deploy": "next build && wrangler deploy",
    "lint": "eslint .",
    "icons": "node scripts/make-icons.mjs public",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.133.0"
  }
}
